# Environment Configuration Template for monitor-go
# Copy this file to .env and fill in your actual values
# This file contains all required environment variables with examples and documentation

# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================

# Optional YAML Configuration File
# Purpose: Path to a YAML file whose values are overridden by .env and the process environment
# Format: File path
# Example: ./config.yaml
CONFIG_PATH=

# =============================================================================
# HTTP SERVER CONFIGURATION
# =============================================================================

# HTTP Server Bind Address
# Purpose: Address and port the HTTP API listens on
# Format: host:port
# Default: 127.0.0.1:3000
# Example: 0.0.0.0:3000
HTTP__ADDRESS=127.0.0.1:3000

# Proxy Header
# Purpose: Header used by Fiber to resolve the client IP when running behind a proxy
# Format: HTTP header name
# Default: X-Forwarded-For
# Example: X-Forwarded-For
HTTP__PROXY_HEADER=X-Forwarded-For

# Trusted Proxies
# Purpose: Proxy IPs or CIDRs allowed to set the proxy header
# Format: JSON array of strings
# Default: (empty)
# Example: ["10.0.0.0/8","192.168.1.10"]
HTTP__PROXIES=

# OpenAPI UI Enabled
# Purpose: Serves the Swagger UI and doc.json under /api/v1/docs
# Format: Boolean (true|false)
# Default: true
# Example: true
HTTP__OPENAPI__ENABLED=true

# OpenAPI Public Host
# Purpose: Host written into the generated OpenAPI document when it differs from the request host
# Format: Hostname (optional)
# Example: api.example.com
HTTP__OPENAPI__PUBLIC_HOST=

# OpenAPI Base Path
# Purpose: Base path written into the generated OpenAPI document
# Format: URL path (optional)
# Example: /api/v1
HTTP__OPENAPI__PUBLIC_PATH=

# =============================================================================
# REDIS CONFIGURATION
# =============================================================================

# Redis Connection URL
# Purpose: Redis instance holding ETag state, parsed records and the outage Pub/Sub channel
# Format: redis:// or rediss:// URL with optional credentials and db number
# Default: redis://localhost:6379
# Example: redis://redis:6379
REDIS__URL=redis://localhost:6379

# =============================================================================
# SCRAPER CONFIGURATION
# =============================================================================

# Scraper Target URL
# Purpose: HTML outage schedule page fetched at the start of each cycle (Windows-1251 encoded)
# Format: http:// or https:// URL
# Default: http://93.92.65.26/aspx/Gorod.htm
# Example: http://93.92.65.26/aspx/Gorod.htm
SCRAPER__URL=http://93.92.65.26/aspx/Gorod.htm

# Scraper Interval
# Purpose: Seconds between scheduler cycles; must be greater than 0
# Format: Positive integer (seconds)
# Default: 300
# Example: 300
SCRAPER__INTERVAL=300

# Pipeline Cycle Timeout
# Purpose: Upper bound for one scrape-parse-diff-publish cycle
# Format: Duration (e.g. 30s, 1m, 5m)
# Default: 1m (clamped to SCRAPER__INTERVAL when that is shorter)
# Example: 1m
SCRAPER__TIMEOUT=1m

# =============================================================================
# STORAGE CONFIGURATION
# =============================================================================

# Storage TTL
# Purpose: Retention window for parsed outage records in Redis; must be greater than 0
# Format: Positive integer (days)
# Default: 5
# Example: 5
STORAGE__TTL_DAYS=5

# Storage Key Prefix
# Purpose: Prefix for the Redis keys holding the ETag and the deduplicated records
# Format: Non-empty string
# Default: bot-005
# Example: bot-005
STORAGE__PREFIX=bot-005

# =============================================================================
# PUBLISHER CONFIGURATION
# =============================================================================

# Publisher Channel Prefix
# Purpose: Prefix for the Redis Pub/Sub channel, which publishes to <prefix>:outages
# Format: Non-empty string
# Default: bot-005
# Example: bot-005
PUBLISHER__PREFIX=bot-005

# =============================================================================
# PARSER CONFIGURATION
# =============================================================================

# Address Parser DB Path
# Purpose: Optional external SQLite streets database for address normalization; empty uses the copy embedded in address-parser-go
# Format: File path (optional)
# Default: (empty - embedded streets.db)
# Example: /etc/monitor-go/streets.db
PARSER__ADDRESS_DB_PATH=
