### Diff: different record (should return it)
POST {{baseUrl}}/api/v1/storage/diff
Content-Type: application/json

{
  "records": [
    {
      "area": "Октябрьский район",
      "organization": {
        "resource": "Холодное водоснабжение",
        "organization": "ООО Водоканал",
        "phones": ["211-11-11"]
      },
      "details": {
        "streets": [
          { "name": "ул. Новая", "buildings": ["5", "7", "9"] }
        ],
        "reason": {
          "type": "плановая",
          "description": "ремонтные работы"
        }
      },
      "dates": ["2026-06-11T09:00:00+07:00"]
    }
  ]
}

